def entropy(labels):
    p = labels.value_counts(normalize=True) # extract value counts  // p vector of numbers 
    return -(p * np.log2(p)).sum()
play = pd.Series(["yes"] * 9 + ["no"] * 5)
print(f"weather data: {entropy(play):.3f} bits")
print(f"training: {entropy(y_train):.3f} | test: {entropy(y_test):.3f} | maximum for 3 classes: {np.log2(3):.3f}")



# your code here






# treshold will be a parameter
def info_gain(x, labels, t):
    left, right = labels[x<t], labels[x>=t]
    n = len(labels)
    return entropy(labels) - (len(left) * entropy(left) + len(right) * entropy(right)) / n
    
print(f"{info_gain(X_train["sepal length"], y_train, 5.75):.2f}")


