def best_split(x, labels):
    """Prova tutti i midpoint tra valori distinti consecutivi; ritorna (soglia, gain)."""
    v = np.sort(x.unique())  # sort unique value and generate vector of candidates (mid point in the middle)
    thresholds = (v[:-1] + v[1:]) / 2
    best_t, best_g = None, -np.inf
    for t in thresholds:   # fir each p we compute the info_gain
        g = info_gain(x, labels, t)
        if g > best_g:
            best_t, best_g = t, g
    return best_t, best_g

pd.DataFrame(
    [best_split(X_train[col], y_train) for col in X_train.columns],
    index=X_train.columns,
    columns=["best threshold", "information gain"],
)


