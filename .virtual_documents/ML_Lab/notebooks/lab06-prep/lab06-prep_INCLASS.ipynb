pca_raw = PCA().fit(Zr)
print("not standardized, ratio:", pca_raw.explained_variance_ratio_.round(3))
print("PC1 loadings:", dict(zip(N_train.columns, pca_raw.components_[0].round(3))))











pca_curve = pd.DataFrame({
    name: {kk: cross_val_score(make_pipeline(prep_std, PCA(kk), m()), R_train, y_train, cv=cv_n, scoring="roc_auc").mean()
