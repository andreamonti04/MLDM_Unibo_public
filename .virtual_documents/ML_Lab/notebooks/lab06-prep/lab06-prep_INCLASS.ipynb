for (n, v), col in zip(no_pca.items(), ["tab:blue", "tab:orange"]):
    ax.axhline(v, ls="--", color=col, lw=1)
ax.set_xlabel("PCA components"); ax.set_ylabel("CV AUC")
plt.show()

gs = GridSearchCV(make_pipeline(prep_std, PCA(), KNeighborsClassifier()),
