                        for sn, sc in scalers.items()})
print(f"{time.time() - t0:.0f} s")
scaling.round(3)











pt = PowerTransformer().fit(N_train[["spend"]])
print(f"skewness: euros {N_train['spend'].skew():.2f} | log10 {np.log10(N_train['spend']).skew():.2f} | "
      f"power {pd.Series(pt.transform(N_train[['spend']]).ravel()).skew():.2f} | lambda = {pt.lambdas_[0]:.3f}")

others = [c for c in N_train.columns if c != "spend"]
