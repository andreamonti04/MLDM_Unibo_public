





'''
Lab is on data preparation, ablation study e PCA.
We will see how to put together column trasformer that executes the data preparation and another estimator to put them together
in a pipeline. Try encodings, scaling, inputers, indicators, e dropping rows (option for doing data preparation) 
How to compare the result to understand what is necessary and what is not.

Architecture of the software is not very simple but efficient --> learn how write sw that has good characteristics of maintanability and 
efficiency in doing operations that are quiete standard. Make pipeline, putting together  estimator and trasformators, try several configuration,
do the ablation study (I have designed a pipeline with a number of components, I obtain a result. and what if I leave out one of the component?
I try to see if the result is worse or doesn't change. If doesnt' change means that the component doesn't necessary.
I can try with or without rescaling, if without rescaling works is fine and so I don't need rescaling.
'''





from pathlib import Path
import time, warnings

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split, StratifiedKFold, GridSearchCV, cross_val_score
from sklearn.pipeline import make_pipeline
from sklearn.compose import make_column_transformer
from sklearn.impute import SimpleImputer, KNNImputer
from sklearn.preprocessing import (OneHotEncoder, OrdinalEncoder, StandardScaler, MinMaxScaler, RobustScaler,
                                   FunctionTransformer, PowerTransformer)
from sklearn.decomposition import PCA
from sklearn.linear_model import LogisticRegression
from sklearn.neighbors import KNeighborsClassifier
from sklearn.svm import SVC
from sklearn.neural_network import MLPClassifier
from sklearn.tree import DecisionTreeClassifier
from sklearn.ensemble import RandomForestClassifier
from sklearn.feature_selection import SelectKBest, f_classif
from sklearn.datasets import load_digits
import sklearn

DATA_DIR = Path("../../data")
NORDICMART_FILE = DATA_DIR / "nordicmart_customers.csv"
SEED = 42

pd.set_option("display.precision", 3)
plt.rcParams["figure.figsize"] = (8, 4)

print("scikit-learn", sklearn.__version__, "| pandas", pd.__version__)


df = pd.read_csv(NORDICMART_FILE)
# besides loading of the data the preparation of the X part without the target and the target in the y value.
X = df.drop(columns="churned")                      # raw attributes, nothing removed
y = df["churned"]
# split into train and test with  stratify YES (we want this)
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, stratify=y, random_state=SEED)
# preparation of StratifiedKFold. If we don't specify shuffle=T the StratifiedKFold simply divides the dataset into slices one ofter the other 
# and it is recorded, with shuffle=T we require a random shuffling before fractioning the training set into the CV buckets.
# IS AN ADDITIONAL ELEMENT OF RANDOMNESS THAT MUST BE CONTROLLED WITH A RANDOM STATE (WE HAVE 0, COMPARABLE WITH MY SOL)
cv_n = StratifiedKFold(n_splits=5, shuffle=True, random_state=0)

# recode part -> the data are for our needs, so sth is unchanged like tier
def recode(X):                                     # FIXED steps of the EDA log (Lecture 6): nothing learned from data
    return pd.DataFrame({
        "customer_id": X["customer_id"],
        "tier": X["tier"],                         # still a string: encoding is a learned step (Part B)
        "age": X["age"].replace(0, np.nan),   # age has the replacing  of 0 in Nan
        "recency": X["days_since_last_buy"].replace(999, np.nan),    
        "never_bought": (X["days_since_last_buy"] == 999).astype(int),    # boolean coded as integer -> if it gets 999 is 1
        "log_spend": np.log10(X["annual_spend"]),
        "sessions": X["web_sessions_month"].fillna(0),   # filled with 0
        "store_only": X["web_sessions_month"].isna().astype(int),    
        "tickets": X["tickets_90d"],
        "postcode": X["postcode"]}, index=X.index)

# recode the train 
R_train = recode(X_train)

# helper function = compare the effects of several variants --> variants and the data part that we want to pass (default is y_train)
def compare(variants, y=y_train):                  # Lab 5, A1: paired comparison on the same folds
    # scores is a dict created starting from variants 
    scores = {name: cross_val_score(est, Xv, y, cv=cv_n, scoring="roc_auc") for name, (est, Xv) in variants.items()} 
    base = next(iter(scores.values()))
    return pd.DataFrame({name: {"CV AUC": s.mean(), "std": s.std(), "diff": (s - base).mean(),
                                "std diff": (s - base).std(), "folds worse": int((s < base).sum())}
                         for name, s in scores.items()}).T.astype({"folds worse": int}).round(3)
# compare produce a DataFrame where for each component we have the various measures like CV AUC, STD DEVI, differences  
# this is the preparation of comparison

# recap of sizes
print(f"training: {len(y_train)} customers, {y_train.sum()} churners | test: {len(y_test)} customers, {y_test.sum()} churners")
R_train.head()





# preparation of one estimator --> tier order (sopra we have done the initial preparation to replace the Nan where 999
# costant recordings not depend from the data in some way --> no risk of data leakage.
TIER_ORDER = [["Basic", "Silver", "Gold"]]  # for encoding of tiers and list of numerical features 
num = ["age", "recency", "never_bought", "log_spend", "sessions", "store_only", "tickets"]


num_pipe = make_pipeline(SimpleImputer(strategy="median"), StandardScaler()) # making pipeline of the SimpleImputer that will fill the missing 
# value with the median and the StandardScaler 
prep = make_column_transformer(   
    (OrdinalEncoder(categories=TIER_ORDER), ["tier"]),   # use OrdinalEncoder for tier, specify the tier order of the categories 
    # we impose that basic is before silver that is before gold (0verride the alphabetic order that would be the default)
    (num_pipe, num),  # num_pipe = pipeline includes pipeline
    verbose_feature_names_out=False)  # avoid output not necessary here 
lr_prep = make_pipeline(prep, LogisticRegression(max_iter=1000))  # final pipeline with the preparation and the logistic regression 
# pass to the logistic regression the maximum number of iteration that is 1000

# ask for the CV score of our pool pipeline that includes prep and logistic regression on R train and y train using as 
# cross validation one we have initalized before (cv_n). 
s_template = cross_val_score(lr_prep, R_train, y_train, cv=cv_n, scoring="roc_auc") 
print(np.round(s_template, 3), f"-> CV AUC {s_template.mean():.3f} ± {s_template.std():.3f}")

# Scoring is AUC so after the computation of this CV score, we have in output one value of each  bucket of CV and so for each of them we have 
# AUC requested. So 5 AUC and then we have the syntesis the final CV (mean of the array of the AUC IN EACH BUCKET) +- the standard deviation
# of the same 





'''
we have the ordinalEncoder of the tier + the numerical features so in the colTrasformer we have only 8 columns
By default the colTrasformer drops the colums that are not mention ->the default is remainder drop. 
So customer_id and postcode are not considered but this is not the problem because customer_id is an dentifier (not uses in modelling) and 
postcode is a single value so it doesn't matter.

Missing standardization of the tier code --> numbers are very small (just 1 to 3) and having a different unit with respect to the other 
features after standardization is not a problem (perfectly comparable -l so we don't need to do it)
If we have a distance base model --> maybe is different (is not the case)
'''








# fitting logistic regression on the whole  R train and look inside it.
# preparation of new customers.
# adding 2 new customers, we add them in a data frame with their id, the tier and the tier is silver and platinum (new tier).
# Those are the 2 records added.
new_customers = pd.DataFrame({"customer_id": ["C-9001", "C-9002"], "tier": ["Silver", "Platinum"], "age": [41, 37],
                              "days_since_last_buy": [12, 140], "annual_spend": [820.0, 2900.0],
                              "web_sessions_month": [6, np.nan], "tickets_90d": [0, 2], "postcode": [40100, 40100]})
new_customers


lr_prep.fit(R_train, y_train)  # fit logistic regressionn and the preparation with r train and y train,
ct = lr_prep[0]  # contents --> lr_prep]0] is extracted from the fitted model 
print("branches:", list(ct.named_transformers_))  # extract branches 
imputer, scaler = ct.named_transformers_["pipeline"]   # component of the pipeline  we are inspecting = the branches are ordinal 
# encoder pipeline, remainder --> result of this operation
display(pd.DataFrame({"median (imputer)": imputer.statistics_, "mean (scaler)": scaler.mean_,
                      "std (scaler)": scaler.scale_}, index=num))

weights = pd.Series(lr_prep[-1].coef_[0], index=ct.get_feature_names_out()).sort_values()
display(weights.to_frame("weight"))

try:   # try to predict the new_customers. This is incldued in a try-except sequence because we esepct an error
    lr_prep.predict_proba(recode(new_customers))
except ValueError as e:
    print("ValueError:", e)

# do one hot encoder and print the new customers
lr_ohe = make_pipeline(make_column_transformer((OneHotEncoder(handle_unknown="ignore"), ["tier"]), (num_pipe, num),
                                              verbose_feature_names_out=False),
                       LogisticRegression(max_iter=1000)).fit(R_train, y_train)
print("P(churn) of the new customers:", lr_ohe.predict_proba(recode(new_customers))[:, 1].round(3))

# weihts of the features in the logistic regression --> some of the are bigger (session or recency) while never bought and 
# age are quite low. Since the features are standardize, low value of coefficients means low significance.


