'''
1. does the fit traform of R train medians and std deviation are computed on all the customers and the the 5 folds AUC are computed.
if we do this, we do the trasformation on the entire data set --> our previous choice do the traformation inside the pipeline that is subject to CV
the preparation is repeated for each class validation fold  using 4 buckets for the trasformation and then the test that it changed the 4 
bucket so the trasformer data are different and the test data is not trasformed.

Comparison between leaky version and no leaky version.
'''


Z_leaky = prep.fit_transform(R_train, y_train)  # leaky version 
s_leaky = cross_val_score(LogisticRegression(max_iter=1000), Z_leaky, y_train, cv=cv_n, scoring="roc_auc") # score of leaky version 
print("leaky   ", np.round(s_leaky, 4), round(s_leaky.mean(), 4))      # print leaky version with also the mean of the CV folds
print("pipeline", np.round(s_template, 4), round(s_template.mean(), 4))  # result of pipeline 
print("leaky - pipeline", np.round(s_leaky - s_template, 4))  # difference between leaky and pipeline 











# display of a chain of methods --> we do a group by on tier, then compute a mean for each group and then we reidex
# according to the tier order assigned and 2 frame churn rate. 
display(y_train.groupby(R_train["tier"]).mean().reindex(TIER_ORDER[0]).to_frame("churn rate")) 

# prep with tier_encoder (receive as a parameter the tire_encoder) --> so make col trasfm  with tier_enc applied to tier 
# verbose_feature_names_out = avoid additional output of the extimation.
def prep_with(tier_encoder):
    return make_column_transformer((tier_encoder, ["tier"]), (num_pipe, num), verbose_feature_names_out=False)

encoders = {"right order": make_pipeline(OrdinalEncoder(categories=TIER_ORDER), StandardScaler()), # cat = TIER_ORDER then do stdscaler
            "alphabetical": make_pipeline(OrdinalEncoder(), StandardScaler()), # using the default (alphabetic)
            "one-hot": OneHotEncoder(handle_unknown="ignore")}  # doeesn't have the std scaler because it returns  only a triplet of 0 and 1.

# inizialize the dict of the tables that will contain the results
tables = {}
# assign 3 values 
# compare the 3 kind of encoders with logistic regression. compare function is in the beginning
# since compare function is applied to several values will generate a vector of values
tables["logistic regression"] = compare({n: (make_pipeline(prep_with(e), LogisticRegression(max_iter=1000)), R_train)
                                         for n, e in encoders.items()})
# same op with KNN
tables["kNN, k=51"] = compare({n: (make_pipeline(prep_with(e), KNeighborsClassifier(51)), R_train)
                               for n, e in encoders.items()})
# same op with Logistic regression
tables["LR, tier only"] = compare({n: (make_pipeline(make_column_transformer((e, ["tier"])), LogisticRegression(max_iter=1000)),
                                       R_train) for n, e in encoders.items()})
pd.concat(tables)


'''
result: for LR there is almost no difference.
CV AUC is 0.823
with KNN there is some difference: in particular (counterintuitive) with the right order the AUC is the smallest while one-hot is higher (strange).

knn is more critical: k = 51 and so it's a big value (less stable).

LR tier only --> not a great difference but the result is worst than the first one.
'''





for n in ["alphabetical", "one-hot"]:
    m = make_pipeline(prep_with(encoders[n]), LogisticRegression(max_iter=1000)).fit(R_train, y_train)
    w = pd.Series(m[-1].coef_[0], index=m[0].get_feature_names_out())
