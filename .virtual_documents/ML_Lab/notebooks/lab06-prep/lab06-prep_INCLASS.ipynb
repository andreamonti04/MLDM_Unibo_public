M_train = R_train.assign(sessions=X_train["web_sessions_month"]).drop(columns="store_only")
num_m = ["age", "recency", "never_bought", "log_spend", "sessions", "tickets"]

def lr_imp(imputer):
    return make_pipeline(make_column_transformer((OrdinalEncoder(categories=TIER_ORDER), ["tier"]),
                                                 (make_pipeline(imputer, StandardScaler()), num_m)),
                         LogisticRegression(max_iter=1000))
compare({"recode of Lecture 6": (lr_prep, R_train),
         "median": (lr_imp(SimpleImputer(strategy="median")), M_train),
         "mean": (lr_imp(SimpleImputer(strategy="mean")), M_train),
         "constant 0": (lr_imp(SimpleImputer(strategy="constant", fill_value=0)), M_train),
         "median + indicator": (lr_imp(SimpleImputer(strategy="median", add_indicator=True)), M_train)})





m = lr_imp(SimpleImputer(strategy="median", add_indicator=True)).fit(M_train, y_train)
m[0].named_transformers_["pipeline"].get_feature_names_out(num_m)








complete = M_train[num_m].notna().all(axis=1)
print(f"kept {complete.sum()} of {len(M_train)} | churn rate kept {y_train[complete].mean():.3f}, dropped {y_train[~complete].mean():.3f}")








prep_std = make_column_transformer((make_pipeline(OrdinalEncoder(categories=TIER_ORDER), StandardScaler()), ["tier"]),
                                   (num_pipe, num), verbose_feature_names_out=False)


Z = prep_std.fit_transform(R_train)
names = prep_std.get_feature_names_out()
print("means", Z.mean(axis=0).round(3), "\nstds ", Z.std(axis=0).round(3))

S = np.cov(Z, rowvar=False)
lam, V = np.linalg.eigh(S)
order = np.argsort(lam)[::-1]
lam, V = lam[order], V[:, order]
print("eigenvalues", lam.round(3), "| sum", lam.sum().round(3), "| trace", np.trace(S).round(3))

pca = PCA().fit(Z)
print("sklearn    ", pca.explained_variance_.round(3))
print("max |difference| of the components, up to the sign:", np.abs(np.abs(pca.components_) - np.abs(V.T)).max().round(10))

scores_hand, scores_sk = Z @ V, pca.transform(Z)
print("max |difference| of the scores, up to the sign:   ", np.abs(np.abs(scores_hand) - np.abs(scores_sk)).max().round(10))
print("variance of the scores", scores_sk.var(axis=0, ddof=1).round(3))











ratio = pca.explained_variance_ratio_
cum = np.cumsum(ratio)
display(pd.DataFrame({"eigenvalue": pca.explained_variance_, "ratio": ratio, "cumulative": cum},
                     index=[f"PC{i}" for i in range(1, 9)]).T)

k = np.arange(1, 9)
fig, ax = plt.subplots(figsize=(7, 3.8))
ax.bar(k, ratio, label="each component")
ax.plot(k, cum, marker="o", color="tab:orange", label="cumulative")
ax.axhline(0.9, ls="--", color="gray")
ax.set_xlabel("principal component"); ax.set_ylabel("fraction of variance"); ax.set_xticks(k); ax.legend()
plt.show()

print("90%:", np.searchsorted(cum, 0.90) + 1, "| 95%:", np.searchsorted(cum, 0.95) + 1,
      "| Kaiser:", (pca.explained_variance_ > 1).sum(), "| PCA(0.9):", PCA(n_components=0.9).fit(Z).n_components_)








flip = np.sign(pca.components_[np.arange(8), np.abs(pca.components_).argmax(axis=1)])   # sign of the largest loading
L = pd.DataFrame((pca.components_ * flip[:, None])[:3].T, index=names, columns=["PC1", "PC2", "PC3"])
display(L.round(2))

scores = pca.transform(Z) * flip                   # same flip for the scores
fig, ax = plt.subplots(figsize=(6.5, 5))
for c, col, lab in [(0, "tab:blue", "loyal"), (1, "tab:orange", "churner")]:
    ax.scatter(*scores[y_train.values == c, :2].T, s=8, alpha=0.4, color=col, label=lab)
ax.set_xlabel(f"PC1 ({ratio[0]:.0%})"); ax.set_ylabel(f"PC2 ({ratio[1]:.0%})"); ax.legend()
plt.show()

