           "kNN, k=51": compare({n: (make_pipeline(prep_spend(st), KNeighborsClassifier(51)), N_train)
                                 for n, st in spend_steps.items()})})











miss = X_train.isna().sum()
miss["age == 0"] = (X_train["age"] == 0).sum()
miss["days_since_last_buy == 999"] = (X_train["days_since_last_buy"] == 999).sum()
